#!/usr/bin/env bash
# update-agents: find the coding-agent CLIs on this Mac, check each one against its newest
# release, and update only the ones that are behind.
#
#   update-agents              show installed vs latest, ask, then update the agents that are behind
#   update-agents claude pi    the same, for only the named agents (still only if they're behind)
#   update-agents --all        run every known updater, even for agents that look current
#   update-agents --yes        update without asking
#   update-agents --list       show the table, how each agent updates, and popular agents you don't have
#   update-agents --install opencode   install agents from that popular list
#   update-agents --uninstall amp      move an agent's program files to the Trash (or run its
#                                      package manager's uninstall); config and history stay.
#                                      Add --dry-run to only print what it would remove.
#   update-agents --json       print the table as JSON (used by the Agent Updater app), then stop
#
# Version checks run in parallel; updaters run one at a time (big downloads, 8 GB Mac). An agent
# counts as updated only when its --version changes; updater output is kept in the log dir printed
# at the end. `pi update --all` also refreshes pi's extensions, which the version check can't see:
# run `update-agents --all pi` to refresh them while pi itself is current.

