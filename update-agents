usage() { sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; }

list_only=0 assume_yes=0 update_all=0 json=0 install=0 uninstall=0 dry_run=0
only=()
for arg in "$@"; do
  case "$arg" in
    -l|--list) list_only=1 ;;
    -y|--yes) assume_yes=1 ;;
    -a|--all|-f|--force) update_all=1 ;;
    -j|--json) json=1 ;;
    -i|--install) install=1 ;;
    --uninstall) uninstall=1 ;;
    -n|--dry-run) dry_run=1 ;;
    -h|--help) usage; exit 0 ;;
    -*) echo "unknown option: $arg" >&2; usage >&2; exit 2 ;;
    *) only+=("$arg") ;;
  esac
done

