# ---- latest versions --------------------------------------------------------

fetch() { curl -fsSL --max-time "$CHECK_TIMEOUT" "$@" 2>/dev/null; }

# GitHub API through gh when it's signed in (higher rate limit), plain curl otherwise.
gh_json() { timeout "$CHECK_TIMEOUT" gh api "$1" </dev/null 2>/dev/null || fetch "https://api.github.com/$1"; }

# latest_of NAME INSTALLED UPDATE_CMD: newest released version on the channel this install follows.
latest_of() {
  local name=$1 installed=$2 cmd=$3 pkg channel
  case $cmd in
    "brew upgrade --cask "*)
      fetch "https://formulae.brew.sh/api/cask/${cmd##* }.json" | jq -r '.version // empty' | cut -d, -f1; return ;;
    "brew upgrade "*)
      fetch "https://formulae.brew.sh/api/formula/${cmd##* }.json" | jq -r '.versions.stable // empty'; return ;;
    *" add -g "*@latest | *" install -g "*@latest)
      pkg=${cmd##* }; pkg=${pkg%@latest}
      fetch "https://registry.npmjs.org/${pkg/\//%2F}/latest" | jq -r '.version // empty'; return ;;
    "uv tool upgrade "* | "pipx upgrade "*)
      fetch "https://pypi.org/pypi/${cmd##* }/json" | jq -r '.info.version // empty'; return ;;
  esac
  case $name in
    claude)
      channel=$(jq -r '.autoUpdatesChannel // empty' "$HOME/.claude/settings.json" 2>/dev/null)
      fetch "https://downloads.claude.ai/claude-code-releases/${channel:-latest}" ;;
    codex) gh_json repos/openai/codex/releases/latest | jq -r '.tag_name // empty' | sed 's/^rust-v//' ;;
    amp) fetch https://static.ampcode.com/cli/cli-version.txt ;;
    cursor-agent) fetch https://cursor.com/install | grep -oE 'downloads\.cursor\.com/lab/[^/]+/' | head -1 | cut -d/ -f3 ;;
    droid) fetch https://downloads.factory.ai/factory-cli/LATEST ;;
    grok) timeout "$CHECK_TIMEOUT" grok update --check --json </dev/null 2>/dev/null | jq -r '.latestVersion // empty' ;;
    pi) fetch https://registry.npmjs.org/@earendil-works%2Fpi-coding-agent/latest | jq -r '.version // empty' ;;
    agy)
      fetch https://antigravity-cli-auto-updater-974169037036.us-central1.run.app |
        grep -oE 'Stable Version: [0-9]+(\.[0-9]+)*' | grep -oE '[0-9.]+$' ;;
    muse)
      fetch -A muse-code/launcher-3 "https://api.meta.ai/muse-code/channels/${MUSE_CHANNEL:-muse-stable}" |
        jq -r '.version // empty' ;;
    t3)
      case $installed in *-nightly*) channel=nightly ;; *-preview*) channel=preview ;; *) channel=stable ;; esac
      gh_json 'repos/pingdotgg/t3code/releases?per_page=50' | jq -r --arg c "$channel" '
        [.[] | select(.draft | not) | .tag_name | select(startswith("v"))
          | select(if $c == "stable" then (contains("-") | not) else contains("-" + $c + ".") end)][0] // empty' |
        sed 's/^v//' ;;
    herdr) fetch https://herdr.dev/latest.json | jq -r '.version // empty' ;;
    opencode) fetch https://registry.npmjs.org/opencode-ai/latest | jq -r '.version // empty' ;;
    goose) gh_json repos/block/goose/releases/latest | jq -r '.tag_name // empty' | sed 's/^v//' ;;
  esac
}

# catalog_latest INSTALL_CMD: newest version the install command would fetch.
catalog_latest() {
  case $1 in
    "npm install -g "*) latest_of '' '' "$1@latest" ;;
    "brew install --cask "*) latest_of '' '' "brew upgrade --cask ${1##* }" ;;
    "brew install "*) latest_of '' '' "brew upgrade ${1##* }" ;;
    "uv tool install "*) latest_of '' '' "uv tool upgrade $(awk '{print $4}' <<<"$1")" ;;
  esac
}

# app_installed NAME: true when NAME is an app entry in SYSTEMS whose bundle is in Applications.
app_installed() {
  local entry name bundles b dir list=()
  for entry in "${SYSTEMS[@]}"; do
    IFS='|' read -r name bundles _ <<<"$entry"
    [[ $name == "$1" && -n $bundles ]] || continue
    IFS=',' read -ra list <<<"$bundles"
    for b in "${list[@]}"; do
      for dir in /Applications "$HOME/Applications"; do [[ -d "$dir/$b.app" ]] && return 0; done
    done
  done
  return 1
}

# install_agents NAME...: install missing agents from CATALOG, one at a time.
install_agents() {
  local want entry name cmd home desc found todo=() cmds=() n=0 failed=0 rc log logdir
  (($#)) || { echo "Name the agents to install, e.g. update-agents --install opencode" >&2; return 2; }
  for want in "$@"; do
    found=''
    for entry in "${CATALOG[@]}"; do
      IFS='|' read -r name cmd home desc <<<"$entry"
      [[ $name == "$want" ]] && found=${cmd//¦/|}
    done
    for entry in "${SYSTEMS[@]}"; do
      IFS='|' read -r name _ _ _ _ cmd <<<"$entry"
      [[ $name == "$want" && -n $cmd ]] && found=$cmd
    done
    if command -v "$want" >/dev/null || app_installed "$want"; then
      echo "  ${dim}·${reset} $want is already installed"
    elif [[ -z $found ]]; then
      echo "  ${red}✗${reset} $want isn't in the install list" >&2; failed=$((failed + 1))
    else
      todo+=("$want") cmds+=("$found")
    fi
  done
  ((${#todo[@]})) || return $((failed > 0))
  if ((dry_run)); then
    for ((n = 0; n < ${#todo[@]}; n++)); do echo "cmd:${cmds[n]}"; done
    return $((failed > 0))
  fi
  if ((!assume_yes)); then
    printf '%s?%s %sInstall %s?%s %s[Y/n]%s ' "$accent" "$reset" "$bold" "$(sed 's/ /, /g' <<<"${todo[*]}")" "$reset" "$dim" "$reset"
    read -r reply || reply=n
    case "${reply:-y}" in [Yy]*) ;; *) echo "Nothing installed."; return 0 ;; esac
  fi
  logdir="${TMPDIR:-/tmp}"; logdir="${logdir%/}/update-agents-$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$logdir"
  for ((n = 0; n < ${#todo[@]}; n++)); do
    log="$logdir/${todo[n]}.log"
    if [[ ${cmds[n]} == *"|"* ]]; then
      # A vendor install script (curl … | sh) needs a shell for the pipe.
      spin "${dim}[$((n + 1))/${#todo[@]}]${reset} installing ${bold}${todo[n]}${reset} ${dim}${cmds[n]}${reset}" "$log" bash -c "${cmds[n]}"
    else
      # shellcheck disable=SC2086 # the command string is meant to split into words
      spin "${dim}[$((n + 1))/${#todo[@]}]${reset} installing ${bold}${todo[n]}${reset} ${dim}${cmds[n]}${reset}" "$log" ${cmds[n]}
    fi
    rc=$?
    hash -r
    if ((rc == 0)) && app_installed "${todo[n]}"; then
      echo "  ${green}✓${reset} ${todo[n]} (app)"
    elif ((rc == 0)) && command -v "${todo[n]}" >/dev/null; then
      echo "  ${green}✓${reset} ${todo[n]} $(version_of "$(command -v "${todo[n]}")")"
    else
      echo "  ${red}✗${reset} ${todo[n]}: $(grep -v '^[[:space:]]*$' "$log" | tail -1 | cut -c1-100)"
      failed=$((failed + 1))
    fi
  done
  echo "  ${dim}Logs: $logdir${reset}"
  ((failed == 0))
}

# appcast_latest FEED: "BUILD SHORT_VERSION" of the newest item in a Sparkle appcast.
appcast_latest() {
  fetch "$1" | awk '
    /sparkle:version>/ { v = $0; gsub(/.*<sparkle:version>|<\/sparkle:version>.*/, "", v) }
    /sparkle:version="/ { v = $0; sub(/.*sparkle:version="/, "", v); sub(/".*/, "", v) }
    /sparkle:shortVersionString>/ { s = $0; gsub(/.*<sparkle:shortVersionString>|<\/sparkle:shortVersionString>.*/, "", s) }
    /sparkle:shortVersionString="/ { s = $0; sub(/.*sparkle:shortVersionString="/, "", s); sub(/".*/, "", s) }
    /<\/item>/ { if (v != "") print v, (s == "" ? v : s); v = ""; s = "" }' | sort -V -k1,1 | tail -1
}

# uninstall_plan NAME: what uninstalling NAME means, one line each: "cmd:COMMAND" for a
# package-manager install, "path:PATH" for program files to move to the Trash. Config and
# history directories (~/.claude, ~/.codex sessions, ...) are never on the list.
uninstall_plan() {
  local name=$1 bin cmd pkg p entry sname bundles L=$HOME/.local/bin paths=() b dir
  # Agent system apps go to the Trash whole.
  for entry in "${SYSTEMS[@]}"; do
    IFS='|' read -r sname bundles _ <<<"$entry"
    [[ $sname == "$name" ]] || continue
    IFS=',' read -ra paths <<<"$bundles"
    for b in ${paths[@]+"${paths[@]}"}; do
      for dir in /Applications "$HOME/Applications"; do
        [[ -d "$dir/$b.app" ]] && echo "path:$dir/$b.app" && return 0
      done
    done
    return 1
  done
  bin=$(command -v "$name") || return 1
  if cmd=$(manager_update "$bin"); then
    pkg=${cmd##* }; pkg=${pkg%@latest}
    case $cmd in
      "brew upgrade --cask "*) echo "cmd:brew uninstall --cask $pkg" ;;
      "brew upgrade "*) echo "cmd:brew uninstall $pkg" ;;
      "npm install -g "*) echo "cmd:npm uninstall -g $pkg" ;;
      "bun add -g "*) echo "cmd:bun remove -g $pkg" ;;
      "pnpm add -g "*) echo "cmd:pnpm remove -g $pkg" ;;
      "uv tool upgrade "*) echo "cmd:uv tool uninstall $pkg" ;;
      "pipx upgrade "*) echo "cmd:pipx uninstall $pkg" ;;
    esac
    return 0
  fi
  case $name in
    claude) paths=("$L/claude" "$HOME/.local/share/claude") ;;
    codex) paths=("$L/codex" "$L/codex-code-mode-host" "$HOME/.codex/packages/standalone") ;;
    amp) paths=("$L/amp" "$HOME/.amp/bin") ;;
    cursor-agent)
      paths=("$L/cursor-agent" "$HOME/.local/share/cursor-agent")
      [[ $(readlink "$L/agent" 2>/dev/null) == *cursor-agent* ]] && paths+=("$L/agent") ;;
    droid) paths=("$L/droid") ;;
    grok) paths=("$L/grok" "$HOME/.grok/bin" "$HOME/.grok/downloads") ;;
    pi) paths=("$L/pi" "$HOME/.pi/agent/bin" "$HOME/.pi/agent/install" "$HOME/.local/share/pi-node") ;;
    agy) paths=("$L/agy" "$L"/agy.*.old) ;;
    muse) paths=("$L/muse" "$L"/muse-bin-* "$L"/.muse-*) ;;
    t3) paths=("$HOME/.t3/bin/t3") ;;
    herdr) paths=("$L/herdr") ;;
    goose) paths=("$L/goose") ;;
    *) return 1 ;;
  esac
  for p in "${paths[@]}"; do [[ -e $p || -L $p ]] && echo "path:$p"; done
  return 0
}

# uninstall_agents NAME...: remove agents (Trash for program files, package manager otherwise).
uninstall_agents() {
  local name plan line trash dest rc failed=0 log
  (($#)) || { echo "Name the agents to uninstall, e.g. update-agents --uninstall amp" >&2; return 2; }
  for name in "$@"; do
    if ! plan=$(uninstall_plan "$name") || [[ -z $plan ]]; then
      if ((dry_run)); then echo "error:don't know how to uninstall $name"
      else echo "  ${red}✗${reset} $name: not installed, or I don't know how it was installed" >&2; fi
      failed=$((failed + 1)); continue
    fi
    if ((dry_run)); then echo "$plan"; continue; fi
    echo "${bold}$name${reset}"
    while IFS= read -r line; do
      case $line in cmd:*) echo "  ${dim}run${reset} ${line#cmd:}" ;; path:*) echo "  ${dim}move to Trash${reset} ${line#path:}" ;; esac
    done <<<"$plan"
    if ((!assume_yes)); then
      printf '%s?%s %sUninstall %s?%s %s[y/N]%s ' "$accent" "$reset" "$bold" "$name" "$reset" "$dim" "$reset"
      read -r reply || reply=n
      case $reply in [Yy]*) ;; *) echo "  Skipped $name."; continue ;; esac
    fi
    trash="$HOME/.Trash/$name (update-agents $(date "+%Y-%m-%d %H.%M.%S"))"
    rc=0
    while IFS= read -r line; do
      case $line in
        cmd:*)
          log=$(mktemp "${TMPDIR:-/tmp}/update-agents-uninstall.XXXXXX")
          # shellcheck disable=SC2086 # the command string is meant to split into words
          spin "uninstalling ${bold}$name${reset} ${dim}${line#cmd:}${reset}" "$log" ${line#cmd:} || {
            rc=1; echo "  ${red}✗${reset} $(grep -v '^[[:space:]]*$' "$log" | tail -1 | cut -c1-100)"; } ;;
        path:*)
          # Keep each file's place under the home folder so the Trash copy is easy to put back.
          dest="$trash${line#path:$HOME}"
          [[ ${line#path:} == "$HOME"/* ]] || dest="$trash/$(basename "${line#path:}")"
          mkdir -p "$(dirname "$dest")" && mv "${line#path:}" "$dest" || rc=1 ;;
      esac
    done <<<"$plan"
    hash -r
    if ((rc == 0)); then
      echo "  ${green}✓${reset} uninstalled $name"
      [[ -d $trash ]] && echo "  ${dim}files are in the Trash: $trash${reset}"
      command -v "$name" >/dev/null && echo "  ${yellow}!${reset} another $name is still on PATH: $(command -v "$name")"
    else
      failed=$((failed + 1))
    fi
  done
  ((failed == 0))
}

# version_status INSTALLED LATEST: current | behind | ahead | unknown.
version_status() {
  local a=${1#v} b=${2#v} ca cb
  [[ -z $a || $a == '?' || -z $b ]] && { echo unknown; return; }
  [[ $a == "$b" ]] && { echo current; return; }
  ca=$(grep -oE '^[0-9]+(\.[0-9]+)*' <<<"$a")
  cb=$(grep -oE '^[0-9]+(\.[0-9]+)*' <<<"$b")
  [[ -z $ca || -z $cb ]] && { echo unknown; return; }
  if [[ $ca != "$cb" ]]; then
    [[ $(printf '%s\n%s\n' "$ca" "$cb" | sort -V | tail -1) == "$cb" ]] && echo behind || echo ahead
  elif [[ $a != *-* && $b == *-* ]]; then
    echo ahead # a release is newer than a prerelease of the same version
  else
    echo behind # same version, different build: trust the release feed
  fi
}

show_apps() {
  local name app plist short build feed latest names=() versions=() states=() nw=0 vw=0 i
  for name in "${APPS[@]}"; do
    for app in "/Applications/$name.app" "$HOME/Applications/$name.app"; do
      [[ -d $app ]] || continue
      status_line "checking ${name}…"
      plist="$app/Contents/Info.plist"
      short=$(defaults read "$plist" CFBundleShortVersionString 2>/dev/null)
      build=$(defaults read "$plist" CFBundleVersion 2>/dev/null)
      feed=$(defaults read "$plist" SUFeedURL 2>/dev/null)
      state="${dim}updates itself${reset}"
      if [[ -n $feed ]]; then
        latest=$(appcast_latest "$feed" | cut -d' ' -f1)
        if [[ -z $latest ]]; then
          state="${yellow}update feed unreachable${reset}"
        elif [[ $latest == "$build" ]]; then
          state="${green}up to date${reset}"
        else
          state="${yellow}update ready ($build → $latest): open the app${reset}"
        fi
      fi
      names+=("$name") versions+=("${short:-?}") states+=("$state")
      ((${#name} > nw)) && nw=${#name}
      ((${#short} > vw)) && vw=${#short}
    done
  done
  clear_line
  ((${#names[@]})) || return 0
  echo
  {
    printf '%s%-*s  %-*s  %s%s\n' "$dim" "$nw" "app" "$vw" "version" "status" "$reset"
    for ((i = 0; i < ${#names[@]}; i++)); do
      printf '%-*s  %-*s  %s\n' "$nw" "${names[i]}" "$vw" "${versions[i]}" "${states[i]}"
    done
  } | box "Desktop apps"
}

