# ---- drawing --------------------------------------------------------------

# Visible width of a string, ignoring color codes.
vislen() {
  local s
  s=$(sed $'s/\e\\[[0-9;]*m//g' <<<"$1")
  echo "${#s}"
}

rep() {
  local out='' i
  for ((i = 0; i < $2; i++)); do out+=$1; done
  printf '%s' "$out"
}

# pad TEXT WIDTH: TEXT followed by spaces up to WIDTH visible characters.
pad() { printf '%s%s' "$1" "$(rep ' ' $(($2 - $(vislen "$1"))))"; }

# box TITLE: draw a rounded border around the lines on stdin.
box() {
  local title=$1 line w width tw i lines=() widths=()
  tw=$(vislen "$title")
  width=$((tw + 2))
  while IFS= read -r line; do
    w=$(vislen "$line")
    lines+=("$line") widths+=("$w")
    ((w > width)) && width=$w
  done
  printf '%s╭─ %s%s%s %s╮%s\n' "$frame" "$reset$bold" "$title" "$reset$frame" "$(rep ─ $((width + 1 - tw)))" "$reset"
  for ((i = 0; i < ${#lines[@]}; i++)); do
    printf '%s│%s  %s%s  %s│%s\n' "$frame" "$reset" "${lines[i]}" "$(rep ' ' $((width - widths[i])))" "$frame" "$reset"
  done
  printf '%s╰%s╯%s\n' "$frame" "$(rep ─ $((width + 4)))" "$reset"
}

# Overwrite the current line with a status message (no-op when not on a terminal).
status_line() { ((tty)) && printf '\r\e[K  %s%s%s' "$dim" "$1" "$reset"; }
clear_line() { ((tty)) && printf '\r\e[K'; }

# spin LABEL LOG CMD...: run CMD with a spinner, output to LOG; returns CMD's exit status.
spin() {
  local label=$1 log=$2 pid i=0 frames='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
  shift 2
  (cd "$HOME" && exec timeout "$UPDATE_TIMEOUT" "$@") </dev/null >"$log" 2>&1 &
  pid=$!
  if ((tty)); then
    while kill -0 "$pid" 2>/dev/null; do
      printf '\r\e[K  %s%s%s %s' "$accent" "${frames:i++%10:1}" "$reset" "$label"
      sleep 0.1
    done
    clear_line
  else
    echo "  $label"
  fi
  wait "$pid"
}

# wait_all LABEL: wait for every background job, with a spinner on a terminal.
wait_all() {
  local i=0 frames='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
  if ((tty)); then
    while [[ -n $(jobs -pr) ]]; do
      printf '\r\e[K  %s%s%s %s%s%s' "$accent" "${frames:i++%10:1}" "$reset" "$dim" "$1" "$reset"
      sleep 0.1
    done
    clear_line
  fi
  wait
}

# ago EPOCH: "5m ago", "3h ago", "2d ago".
ago() {
  local s=$(($(date +%s) - $1))
  if ((s < 60)); then echo "just now"
  elif ((s < 3600)); then echo "$((s / 60))m ago"
  elif ((s < 86400)); then echo "$((s / 3600))h ago"
  else echo "$((s / 86400))d ago"
  fi
}

# ---- discovery ------------------------------------------------------------

# Longest version-looking token on the first line of `--version`
# ("Muse Code 1.4.13 (1.4.13-R6996.1)" -> 1.4.13-R6996.1).
version_of() {
  timeout 20 "$1" --version </dev/null 2>&1 | head -1 |
    grep -oE '[0-9]+(\.[0-9]+)+[-+.A-Za-z0-9]*' |
    awk 'length > length(best) { best = $0 } END { print best }'
}

# Prints the package-manager command that owns this binary, if any.
manager_update() {
  local real rest pkg
  real=$(realpath "$1" 2>/dev/null) || return 1
  case "$real" in
    */Cellar/*)   rest=${real#*/Cellar/};   echo "brew upgrade ${rest%%/*}" ;;
    */Caskroom/*) rest=${real#*/Caskroom/}; echo "brew upgrade --cask ${rest%%/*}" ;;
    */node_modules/*)
      rest=${real#*/node_modules/}
      if [[ $rest == @* ]]; then pkg=$(cut -d/ -f1-2 <<<"$rest"); else pkg=${rest%%/*}; fi
      case "$real" in
        */.bun/*)  echo "bun add -g $pkg@latest" ;;
        */pnpm/*)  echo "pnpm add -g $pkg@latest" ;;
        *)         echo "npm install -g $pkg@latest" ;;
      esac ;;
    */uv/tools/*)    rest=${real#*/uv/tools/};    echo "uv tool upgrade ${rest%%/*}" ;;
    */pipx/venvs/*)  rest=${real#*/pipx/venvs/};  echo "pipx upgrade ${rest%%/*}" ;;
    *) return 1 ;;
  esac
}

# selected NAME [WANTED...]: true when no names were given or NAME is one of them.
selected() {
  local want=$1 n; shift
  (($# == 0)) && return 0
  for n in "$@"; do [[ $n == "$want" ]] && return 0; done
  return 1
}

# Where the running version actually lives, for "last updated". Launchers and shims keep a
# fixed path across updates, so point at their versioned install instead.
install_path_of() {
  local name=$1 bin=$2 version=$3 p='' real
  real=$(realpath "$bin" 2>/dev/null) || real=$bin
  case $name in
    pi) p="$HOME/.pi/agent/install/releases/$(cat "$HOME/.pi/agent/install/current-version" 2>/dev/null)" ;;
    t3) p="$HOME/.t3/runtime/versions/$version" ;;
    muse) p="$(dirname "$real")/muse-bin-$version" ;;
  esac
  [[ -n $p && -e $p ]] || p=$real
  echo "$p"
}

# kind_of NAME: "orchestrator" for tools that run and coordinate other agents, "system" for
# always-on personal agents, else "agent" (a coding harness).
kind_of() {
  case $1 in
    herdr | Rex | cmux | dmux | workmux | agent-deck | aoe | claude-squad | ccmanager) echo multiplexer ;;
    t3 | Orca | Conductor | Superset | Emdash | Nimbalyst | Sculptor | Warp | Kiro | Zed) echo ade ;;
    vibe-kanban | paperclipai | ruflo | happy | paseo | gt | ralph | omnara) echo orchestrator ;;
    hermes | openclaw | nanobot | octop | openmausbot) echo system ;;
    *) echo agent ;;
  esac
}

