# agent_table KIND TITLE: one box for the agents of that kind (skipped when there are none).
agent_table() {
  local kind=$1 title=$2 i count=0 late=0 installed latest updated state
  for ((i = 0; i < ${#names[@]}; i++)); do
    [[ ${kinds[i]} == "$kind" ]] || continue
    count=$((count + 1))
    [[ ${statuses[i]} == behind ]] && late=$((late + 1))
  done
  ((count)) || return 0
  {
    printf '%s%s  %s  %s  %s  %s' "$dim" "$(pad name "$nw")" "$(pad installed "$iw")" "$(pad latest "$lw")" "$(pad updated "$uw")" "$(pad status 20)"
    ((list_only)) && printf '  updates with'
    printf '%s\n' "$reset"
    for ((i = 0; i < ${#names[@]}; i++)); do
      [[ ${kinds[i]} == "$kind" ]] || continue
      installed=${befores[i]} latest=${latests[i]:-?} updated='?'
      ((mtimes[i] > 0)) && updated=$(ago "${mtimes[i]}")
      case ${statuses[i]} in
        current) state="${green}✓ up to date${reset}"; latest="$dim$latest$reset" ;;
        behind)  state="${yellow}↑ update available${reset}"; installed="$yellow$installed$reset"; latest="$bold$green$latest$reset" ;;
        ahead)   state="${green}✓ ahead of release${reset}"; latest="$dim$latest$reset" ;;
        *)       state="${dim}? couldn't check${reset}" ;;
      esac
      [[ -z ${cmds[i]} ]] && state+=" ${dim}· no updater${reset}"
      printf '%s  %s  %s  %s%s%s  %s' "$(pad "${names[i]}" "$nw")" "$(pad "$installed" "$iw")" "$(pad "$latest" "$lw")" \
        "$dim" "$(pad "$updated" "$uw")" "$reset" "$(pad "$state" 20)"
      ((list_only)) && printf '  %s%s%s' "$dim" "${labels[i]:-no known updater}" "$reset"
      printf '\n'
    done
  } | if ((late)); then box "$title · $count · $late behind"; else box "$title · $count · all current"; fi
}

