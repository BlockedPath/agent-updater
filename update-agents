if ((${#sys_names[@]})); then
  sw=4 svw=9
  for ((k = 0; k < ${#sys_names[@]}; k++)); do
    ((${#sys_names[k]} > sw)) && sw=${#sys_names[k]}
    ((${#sys_short[k]} > svw)) && svw=${#sys_short[k]}
  done
  late=0
  {
    printf '%s%s  %s  %s  %s  %s%s\n' "$dim" "$(pad name "$sw")" "$(pad installed "$svw")" "$(pad latest "$svw")" "$(pad updated "$uw")" "status" "$reset"
    for ((k = 0; k < ${#sys_names[@]}; k++)); do
      installed=${sys_short[k]:-—} latest=${sys_lshort[k]:-—} updated='—'
      ((sys_mtime[k] > 0)) && updated=$(ago "${sys_mtime[k]}")
      case ${sys_status[k]} in
        current) state="${green}✓ up to date${reset}"; latest="$dim$latest$reset" ;;
        behind)  state="${yellow}↑ update ready: open the app${reset}"; installed="$yellow$installed$reset"; latest="$bold$green$latest$reset"; late=$((late + 1)) ;;
        ahead)   state="${green}✓ ahead of release${reset}" ;;
        self)    state="${dim}updates itself${reset}" ;;
        web)     state="${dim}web & mobile · ${sys_homes[k]#https://}${reset}" ;;
        *)       state="${dim}? couldn't check${reset}" ;;
      esac
      printf '%s  %s  %s  %s%s%s  %s\n' "$(pad "${sys_names[k]}" "$sw")" "$(pad "$installed" "$svw")" "$(pad "$latest" "$svw")" \
        "$dim" "$(pad "$updated" "$uw")" "$reset" "$state"
    done
  } | if ((late)); then box "Agent apps · ${#sys_names[@]} · $late behind"; else box "Agent apps · ${#sys_names[@]}"; fi
fi

((${#only[@]})) || show_apps
if ((list_only && ${#avail[@]})); then
  echo
  aw=4 vw=6 cw=7
  for entry in "${avail[@]}"; do
    IFS='|' read -r name cmd _ <<<"$entry"
    cmd=${cmd//¦/|}
    ((${#name} > aw)) && aw=${#name}
    ((${#cmd} > cw)) && cw=${#cmd}
  done
  for ((k = 0; k < ${#avail[@]}; k++)); do
    v=$(cat "$checkdir/avail.$k" 2>/dev/null)
    ((${#v} > vw)) && vw=${#v}
  done
  {
    printf '%s%-*s  %-12s  %-*s  %-13s  %-*s  %s%s\n' "$dim" "$aw" "name" "kind" "$vw" "latest" "runs on" "$cw" "install with" "about" "$reset"
    for ((k = 0; k < ${#avail[@]}; k++)); do
      IFS='|' read -r name cmd _ desc <<<"${avail[k]}"
      cmd=${cmd//¦/|}
      v=$(cat "$checkdir/avail.$k" 2>/dev/null)
      os=$(jq -r --arg n "$name" '(.[$n].platforms // []) | map({macos:"mac",linux:"linux",windows:"win",ios:"ios",android:"android",web:"web"}[.]) | join(" ")' "$PLATFORMS_FILE" 2>/dev/null)
      printf '%-*s  %-12s  %-*s  %-13s  %s%-*s%s  %s%s%s\n' "$aw" "$name" "$(kind_of "$name")" "$vw" "${v:-?}" "${os:-?}" "$dim" "$cw" "$cmd" "$reset" "$dim" "$desc" "$reset"
    done
  } | box "Not installed · update-agents --install NAME"
fi
((list_only)) && exit 0

if ((${#unknown[@]} && !update_all)); then
  echo "  ${dim}Couldn't check ${unknown[*]}. Update anyway: update-agents --all ${unknown[*]}${reset}"
fi

if ((${#todo[@]} == 0)); then
  echo "  ${green}✓${reset} Nothing to update."
  exit 0
fi

todo_names=()
for i in "${todo[@]}"; do todo_names+=("${names[i]}"); done
if ((!assume_yes)); then
  ((${#todo[@]} == 1)) && noun=agent || noun=agents
  printf '\n%s?%s %sUpdate %d %s%s %s(%s)%s %s[Y/n]%s ' "$accent" "$reset" "$bold" "${#todo[@]}" "$noun" "$reset" \
    "$dim" "$(sed 's/ /, /g' <<<"${todo_names[*]}")" "$reset" "$dim" "$reset"
  read -r reply || reply=n
  [[ -t 0 ]] || echo
  case "${reply:-y}" in
    [Yy]*) ;;
    *) echo "Nothing updated."; exit 0 ;;
  esac
fi
echo

logdir="${TMPDIR:-/tmp}"; logdir="${logdir%/}/update-agents-$(date +%Y%m%d-%H%M%S)"
mkdir -p "$logdir"

rnames=() icons=() vers=() states=() notes=() updated=0 failed=0 n=0 cw=0
for i in "${todo[@]}"; do
  name=${names[i]} before=${befores[i]} cmd=${cmds[i]} latest=${latests[i]}
  n=$((n + 1))
  log="$logdir/$name.log"
  # shellcheck disable=SC2086 # the command string is meant to split into words
  spin "${dim}[$n/${#todo[@]}]${reset} updating ${bold}$name${reset} ${dim}${labels[i]}${reset}" "$log" $cmd
  rc=$?
  hash -r
  after=$(version_of "$(command -v "$name" || echo "${bins[i]}")")
  after=${after:-?}
  # Some updaters stage the new version and leave the old one running ("Updating A → B").
  target=$(grep -oE '(→|->) *v?[0-9]+(\.[0-9]+)+[-+.A-Za-z0-9]*' "$log" | tail -1 |
    grep -oE '[0-9]+(\.[0-9]+)+[-+.A-Za-z0-9]*')

  rnames+=("$name")
  if ((rc != 0)); then
    ((rc == 124)) && state="timed out after ${UPDATE_TIMEOUT}s" || state="failed (exit $rc)"
    icons+=("${red}✗${reset}") vers+=("$before") states+=("${red}$state${reset}")
    notes+=("${red}✗${reset} $name: $(grep -v '^[[:space:]]*$' "$log" | tail -1 | sed 's/^[[:space:]]*//' | cut -c1-100)")
    failed=$((failed + 1))
  elif [[ $before != "$after" ]]; then
    icons+=("${green}✓${reset}") vers+=("$before → ${green}$after${reset}") states+=("${green}updated${reset}")
    updated=$((updated + 1))
  elif [[ -n $target && $target != "$after" ]]; then
    icons+=("${yellow}↻${reset}") vers+=("$before → ${yellow}$target${reset}") states+=("${yellow}restart to finish${reset}")
    notes+=("${yellow}↻${reset} $name: $(grep -i 'restart' "$log" | tail -1 | sed 's/^[[:space:]]*//' | cut -c1-100)")
    updated=$((updated + 1))
  elif [[ ${statuses[i]} == behind ]]; then
    icons+=("${yellow}!${reset}") vers+=("$before") states+=("${yellow}unchanged (latest is $latest)${reset}")
    notes+=("${yellow}!${reset} $name: updater finished but the version didn't change; see $log")
    failed=$((failed + 1))
  else
    icons+=("${dim}·${reset}") vers+=("$before") states+=("${dim}up to date${reset}")
  fi
done

widths=()
for ((k = 0; k < ${#rnames[@]}; k++)); do
  widths+=("$(vislen "${vers[k]}")")
  ((widths[k] > cw)) && cw=${widths[k]}
done
{
  for ((k = 0; k < ${#rnames[@]}; k++)); do
    printf '%s %-*s  %s%s  %s\n' "${icons[k]}" "$nw" "${rnames[k]}" "${vers[k]}" "$(rep ' ' $((cw - widths[k])))" "${states[k]}"
  done
} | if ((updated + failed)); then box "Results · $updated updated, $failed failed"; else box "Results · all up to date"; fi

for note in ${notes[@]+"${notes[@]}"}; do echo "  $note"; done
((updated)) && echo "  ${dim}Restart running agent sessions to use the new versions.${reset}"
echo "  ${dim}Logs: $logdir${reset}"
((failed == 0))
